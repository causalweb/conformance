{
  "name": "@causalweb/conformance",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "description": "Language-neutral Causal Web conformance harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/causalweb/conformance.git"
  },
  "license": "Apache-2.0 OR MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
