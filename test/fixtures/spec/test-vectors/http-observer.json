        "body": "covered",
        "read_calls": 1
      }
    },
    {
      "id": "OBS-002",
      "request": { "method": "GET" },
      "expected": {
        "status": 412,
        "causal_result": "unsatisfied",
        "cache_control": "no-store",
        "outcomes": [{ "index": 0, "outcome": "unsatisfied", "retryable": true }],
        "read_calls": 1
      }
    }
  ]
