{
  "format": "causal-web-http-observer-v1",
  "assumptions": {
    "issuer": "https://issuer.example",
    "audience": "https://verifier.example/causal",
    "subject": "opaque-tenant",
    "domain": "https://issuer.example/domains/orders/2026",
    "target": "/orders/123",
    "validation_time": 100
  },
  "cases": [
    {
      "id": "OBS-001",
      "request": { "method": "GET" },
      "expected": {
        "status": 200,
        "causal_result": "satisfied",
